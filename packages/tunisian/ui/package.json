{
  "name": "@tunisian/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tunisian Belote game-specific UI components and hooks",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
